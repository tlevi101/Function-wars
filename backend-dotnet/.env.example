# Copy to .env before `docker compose up`. Compose reads .env automatically.
#
#   cp .env.example .env
#
# Variable names mirror ../backend/.env.example where they overlap, so the two
# backends stay legible side by side.

############
# DATABASE #
############
# Consumed by the db container to create the database and user on first boot.
# NOTE: these take effect only on the FIRST start, while the data volume is empty.
# To change them later: docker compose down -v (this deletes the database).
DB_DATABASE=function_wars
DB_USERNAME=functionwars
DB_PASSWORD=functionwars
DB_ROOT_PASSWORD=root

# Host port for the database. 3307 rather than 3306 so it cannot collide with a
# MySQL/MariaDB already running on the host for the Node backend.
DB_PORT=3307

# Connecting the app to the database is not wired up yet. From inside the api
# container the host is `db` and the port is 3306 (not DB_PORT — that is the
# host-side mapping only).

#########
# PORTS #
#########
API_PORT=5001
ADMINER_PORT=8080

################
# FILE OWNERSHIP #
################
# The api container runs as this uid/gid so files it writes into the bind mount
# (obj/, bin/) are owned by you rather than root. Defaults match `id -u` / `id -g`.
DOCKER_UID=1000
DOCKER_GID=1000
